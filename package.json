{
  "name": "three",
  "version": "0.187.0",
  "description": "JavaScript 3D library",
  "type": "module",
  "packageManager": "bun@1.4.6",
  "module": "./build/three.webgpu.js",
  "exports": {
    ".": "./build/three.webgpu.js",
    "./examples/fonts/*": "./examples/fonts/*",
    "./examples/jsm/*": "./examples/jsm/*",
    "./addons": "./examples/jsm/Addons.js",
    "./addons/*": "./examples/jsm/*",
    "./src/*": "./src/*",
    "./webgpu": "./build/three.webgpu.js",
    "./webgpu-nodes": "./build/three.webgpu.nodes.js",
    "./tsl": "./build/three.tsl.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrdoob/three.js"
  },
  "sideEffects": [
    "./src/nodes/**/*"
  ],
  "files": [
    "build",
    "examples/jsm",
    "LICENSE",
    "package.json",
    "README.md",
    "src"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "start": "bun run dev",
    "test": "bun lint && bun test",
    "build": "bun run utils/build/build.ts",
    "build-docs": "bun --preload ./utils/docs/jsdoc-bun.ts node_modules/jsdoc/jsdoc.js -c utils/docs/jsdoc.config.json && bun run build-llms",
    "build-llms": "bun run utils/llms/build.js",
    "dev": "bun run utils/build/dev.js && bun run utils/server.js -p 8080",
    "preview": "bun run utils/build/preview.js",
    "lint": "bun lint",
    "lint-fix": "bun lint --fix",
    "fmt": "bun fmt package.json bunfig.toml .github/workflows/ci.yml .github/workflows/bundle-size.yml",
    "benchmark-node-material-instance": "bun run test/benchmarks/node-material-instance.js",
    "test-e2e": "bun run test/e2e/puppeteer.js",
    "test-e2e-cov": "bun run test/e2e/check-coverage.js",
    "test-treeshake": "bun run test/treeshake/treeshake.ts",
    "make-screenshot": "bun run test/e2e/puppeteer.js --make",
    "make-tsl-reference": "bun run test/unit/tsl/make.js"
  },
  "keywords": [
    "three",
    "three.js",
    "javascript",
    "3d",
    "virtual-reality",
    "augmented-reality",
    "webaudio",
    "webgpu",
    "webxr",
    "canvas",
    "svg",
    "html5"
  ],
  "author": "mrdoob",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrdoob/three.js/issues"
  },
  "homepage": "https://threejs.org/",
  "devDependencies": {
    "eslint-plugin-jsdoc": "^65.0.0",
    "happy-dom": "^21.0.4",
    "jpeg-js": "^0.4.4",
    "jsdoc": "^4.0.5",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.0.0",
    "turndown": "^7.2.2"
  },
  "patchedDependencies": {
    "jsdoc@4.0.5": "patches/jsdoc@4.0.5.patch"
  }
}
